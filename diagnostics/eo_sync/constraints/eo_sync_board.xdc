create_clock -name ref27 -period 37.037037 [get_ports osc27_p]
create_clock -name camera2 -period 6.734007 [get_ports CAM1_PCLK]
set_clock_uncertainty 0.100 [get_clocks camera2]
# Zero-reference aperture only; not measured camera/board timing.
set_input_delay -clock camera2 -min 0 [get_ports {CAM1_YOUT[*] CAM1_COUT[*]}]
set_input_delay -clock camera2 -max 0 [get_ports {CAM1_YOUT[*] CAM1_COUT[*]}]
create_clock -name camera3 -period 6.734007 [get_ports CAM2_PCLK]
set_clock_uncertainty 0.100 [get_clocks camera3]
# Zero-reference aperture only; not measured camera/board timing.
set_input_delay -clock camera3 -min 0 [get_ports {CAM2_YOUT[*] CAM2_COUT[*]}]
set_input_delay -clock camera3 -max 0 [get_ports {CAM2_YOUT[*] CAM2_COUT[*]}]
create_clock -name camera4 -period 6.734007 [get_ports CAM3_PCLK]
set_clock_uncertainty 0.100 [get_clocks camera4]
# Zero-reference aperture only; not measured camera/board timing.
set_input_delay -clock camera4 -min 0 [get_ports {CAM3_YOUT[*] CAM3_COUT[*]}]
set_input_delay -clock camera4 -max 0 [get_ports {CAM3_YOUT[*] CAM3_COUT[*]}]
create_clock -name camera5 -period 6.734007 [get_ports CAM4_PCLK]
set_clock_uncertainty 0.100 [get_clocks camera5]
# Zero-reference aperture only; not measured camera/board timing.
set_input_delay -clock camera5 -min 0 [get_ports {CAM4_YOUT[*] CAM4_COUT[*]}]
set_input_delay -clock camera5 -max 0 [get_ports {CAM4_YOUT[*] CAM4_COUT[*]}]
create_clock -name camera6 -period 6.734007 [get_ports CAM5_PCLK]
set_clock_uncertainty 0.100 [get_clocks camera6]
# Zero-reference aperture only; not measured camera/board timing.
set_input_delay -clock camera6 -min 0 [get_ports {CAM5_YOUT[*] CAM5_COUT[*]}]
set_input_delay -clock camera6 -max 0 [get_ports {CAM5_YOUT[*] CAM5_COUT[*]}]
set_clock_groups -asynchronous -group [get_clocks ref27] -group [get_clocks camera2] -group [get_clocks camera3] -group [get_clocks camera4] -group [get_clocks camera5] -group [get_clocks camera6]
set_false_path -to [get_ports {TRIG_IN1 TRIG_IN2 TRIG_IN3 TRIG_IN4 TRIG_IN5}]
set_property SLEW SLOW [get_ports {TRIG_IN1 TRIG_IN2 TRIG_IN3 TRIG_IN4 TRIG_IN5}]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
